{
  "name": "site-admin-console",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/start.mjs",
    "test": "node --test --experimental-test-isolation=none --test-concurrency=1 test/*.test.mjs",
    "check": "node --experimental-vm-modules scripts/check.mjs",
    "build": "node scripts/build-v2.mjs",
    "typecheck": "tsc --noEmit",
    "test:v2": "node --test --test-concurrency=1 test/v2/*.test.mjs",
    "licenses": "node scripts/licenses.mjs",
    "sbom": "node scripts/sbom.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@floating-ui/dom": "1.8.0",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "ajv": "8.20.0",
    "countries-list": "3.4.1",
    "fflate": "0.8.3",
    "parse5": "8.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
