# Yerel pilot. Bu dosyayı .env olarak kopyalayın; gerçek sırları Git'e eklemeyin.
PORT=4317
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4317
# DATA_DIR=./data

# Google reCAPTCHA v2 "Ben robot değilim" checkbox anahtarları.
# Tanımlandıktan sonra hem yerel parola hem sosyal giriş başlatma için zorunludur.
# Gerçek alan adında zorunludur; yerelde de zorlamak için 1 kullanın.
AUTH_REQUIRE_CAPTCHA=0
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Her sağlayıcının tam dönüş adresi: APP_ORIGIN/auth/<provider>/callback
# Tanımlanmamış sağlayıcılar kapalı kalır. İlk bağlantı Hesabım içinden yapılır.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Apple web girişi gerçek HTTPS alan adı ve Services ID gerektirir.
# İsim/e-posta kapsamı istenmez; code + query akışı ve kalıcı sub kimliği kullanılır.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM içindeki satır sonlarını \n olarak yazın veya çok satırlı tırnaklı değer kullanın.
APPLE_PRIVATE_KEY=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Meta uygulamanızda desteklenen Graph sürümünü açıkça belirtin; örn. vXX.0.
FACEBOOK_GRAPH_VERSION=
